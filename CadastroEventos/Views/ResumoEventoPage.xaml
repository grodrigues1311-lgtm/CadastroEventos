<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CadastroEventos.Views.ResumoEventoPage"
    Title="Resumo do Evento"
    BackgroundColor="#F4F6FA">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Label
                Text="Resumo do Evento"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#263A63"
                HorizontalOptions="Center"/>

            <Label Text="Nome do evento:" FontAttributes="Bold"/>
            <Label Text="{Binding NomeEvento}" FontSize="18"/>

            <Label Text="Data de início:" FontAttributes="Bold"/>
            <Label Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}"/>

            <Label Text="Data de término:" FontAttributes="Bold"/>
            <Label Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}"/>

            <Label Text="Participantes:" FontAttributes="Bold"/>
            <Label Text="{Binding NumeroParticipantes}"/>

            <Label Text="Local:" FontAttributes="Bold"/>
            <Label Text="{Binding LocalEvento}"/>

            <Label Text="Custo por participante:" FontAttributes="Bold"/>
            <Label Text="{Binding CustoPorParticipante, StringFormat='R$ {0:N2}'}"/>

            <Label Text="Duração do evento:" FontAttributes="Bold"/>
            <Label Text="{Binding DuracaoEmDias, StringFormat='{0} dias'}"/>

            <BoxView HeightRequest="2" Color="#263A63"/>

            <Label
                Text="CUSTO TOTAL"
                FontAttributes="Bold"
                FontSize="18"
                TextColor="#263A63"
                HorizontalOptions="Center"/>

            <Label
                Text="{Binding CustoTotal, StringFormat='R$ {0:N2}'}"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#16834A"
                HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
